{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeJournal",
  "version": "2.2.1",
  "identifier": "com.famasalo.tradejournal",
  "build": {
    "beforeDevCommand": "npm run web:build",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TradeJournal",
        "width": 1480,
        "height": 940,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "backgroundColor": "#080d13",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "FamaSALO",
    "copyright": "Copyright © 2026 FamaSALO",
    "shortDescription": "Локальный дневник трейдера",
    "longDescription": "TradeJournal — локальный дневник трейдера с графиками, календарём, аналитикой и резервными копиями.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RkRGNTE0NUJGOUY3Q0EKUldUSzkvbGJGUFg5ZFdOVlVaRW9jNlNJV1FmZ0FIaEdEcTE1NHhhbWJ2RG1aZXhQS3gvNGlQd3EK",
      "endpoints": [
        "https://github.com/FamaSALO/tradejournal/releases/latest/download/latest.json"
      ]
    }
  }
}
